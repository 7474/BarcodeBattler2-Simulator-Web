{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "barcode-battler-web",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-23",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "barcode-battler",
      // Run `npx wrangler d1 create barcode-battler` and replace this ID.
      // Initialize with `npx wrangler d1 migrations apply barcode-battler --remote`.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "IMAGES",
      // Create before deployment: `npx wrangler r2 bucket create barcode-battler-images`.
      "bucket_name": "barcode-battler-images"
    }
  ]
}
