{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "barcode-battler-web",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-23",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "bb2.koudenpa.net",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "barcode-battler",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "barcode-battler-images"
    }
  ]
}
